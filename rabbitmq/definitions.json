  "policies": [
    {
      "vhost": "birdlab",
      "name": "bird-main-dlx",
      "pattern": "^bird\\.analysis\\.(requests|results)$",
      "apply-to": "quorum_queues",
      "definition": {
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "delivery-limit": 5,
        "dead-letter-exchange": "bird.analysis.dlx",
        "dead-letter-routing-key": "analysis.dead"
      },
      "priority": 10
    },
    {
      "vhost": "birdlab",
      "name": "bird-requests-retry-1",
      "pattern": "^bird\\.analysis\\.requests\\.retry\\.1$",
      "apply-to": "quorum_queues",
      "definition": {
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "delivery-limit": 5,
        "message-ttl": 10000,
        "dead-letter-exchange": "bird.analysis",
        "dead-letter-routing-key": "analysis.requested"
      },
      "priority": 10
    },
